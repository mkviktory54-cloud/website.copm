{
  "name": "QuoteRequest",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "service_needed": {
      "type": "string",
      "enum": [
        "Pressure Washing",
        "Window Cleaning",
        "Multiple Services",
        "Other"
      ]
    },
    "preferred_date": {
      "type": "string",
      "format": "date"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "quoted",
        "won",
        "lost"
      ],
      "default": "new"
    }
  },
  "required": [
    "name",
    "email",
    "phone",
    "service_needed"
  ]
}